# Dictionary containing normal ranges for all animal species
# Format: (bt_min, bt_max, hr_min, hr_max, oxygen_min, oxygen_max)

species_ranges = {
    "Orangutan": (36.1, 36.5, 70, 120, 10, 20),
    "Tapirus": (36.0, 37.0, 40, 70, 10, 20),
    "Elephant": (36.0, 36.9, 25, 45, 10, 20),
    "Tiger": (37.8, 39.4, 60, 100, 10, 20),
    "Pangolins": (31.7, 34.2, 50, 100, 10, 20)
}


def get_heart_rate():
    animal_id = input("Enter Animal ID: ")
    species = input("Enter animal species: ").strip().title()
    heart_rate = float(input("Enter heart rate (BPM): "))
    return animal_id, species, heart_rate


def get_species_normal_range(species):
    return species_ranges.get(species)


def validate_heart_rate(heart_rate):
    return heart_rate > 0


def classify_heart_rate(heart_rate, normal_range):
    bt_min, bt_max, hr_min, hr_max, oxygen_min, oxygen_max = normal_range

    if hr_min is None:
        return "Heart Rate Range Unavailable"

    if heart_rate < hr_min:
        return "Low Heart Rate"
    elif heart_rate > hr_max:
        return "High Heart Rate"
    else:
        return "Normal Heart Rate"


# Main program
try:
    animal_id, species, heart_rate = get_heart_rate()
    normal_range = get_species_normal_range(species)

    if normal_range is None:
        print("Species not supported.")
    elif not validate_heart_rate(heart_rate):
        print("Invalid heart rate.")
    else:
        result = classify_heart_rate(heart_rate, normal_range)
        print("Animal ID:", animal_id)
        print("Result:", result)

except ValueError:
    print("Please enter a valid number.")